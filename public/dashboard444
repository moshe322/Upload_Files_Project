<!DOCTYPE html>
<html>
<head>
<title>Dashboard</title>

<style>
body {
    font-family: Arial;
    background: #6F4E37; /* ☕ coffee color */
    margin: 0;
    padding: 20px;
    color: white;
}

   /*  background: url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover; */
     background: url('assets/images/dashboard-bg.png');

.header {
    text-align: center;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
}

/* Upload section */
.upload-section {
    width: 300px;
    background: white;
    color: black;
    padding: 15px;
    border-radius: 10px;
}

/* File input */
input[type="file"] {
    background: blue;
    color: white;
    padding: 8px;
    border-radius: 5px;
    width: 100%;
}

/* Upload button */
.upload-btn {
    background: green;
    color: white;
    padding: 10px;
    border: none;
    width: 100%;
    margin-top: 10px;
    cursor: pointer;
}

/* Files section */
.files-section {
    margin-top: 20px;
    background: white;
    color: black;
    padding: 15px;
    border-radius: 10px;
}

/* File boxes */
.file-box {
    background: pink;
    padding: 10px;
    margin: 5px 0;
    border-radius: 6px;
    display: flex;
    justify-content: space-between;
}

/* Delete button */
.delete-btn {
    background: red;
    color: white;
    padding: 10px;
    border: none;
    margin-bottom: 10px;
}
</style>

</head>

<body>

<div class="header">Welcome to Document Page</div>

<div class="upload-section">
    <h3>Upload File</h3>

    <form id="uploadForm">
        <input type="file" id="resume" required>
        <button class="upload-btn" type="submit">Upload</button>
    </form>

    <p id="msg"></p>
</div>

<hr>

<div class="files-section">
    <h3>Your Files</h3>

    <button class="delete-btn" onclick="deleteSelected()">Delete Selected</button>

    <div id="fileList"></div>
</div>

<script>

// 🔥 DEBUG UPLOAD
document.getElementById("uploadForm").addEventListener("submit", async function(e) {
    e.preventDefault();

    let file = document.getElementById("resume").files[0];

    if (!file) {
        alert("Select file first");
        return;
    }

    let formData = new FormData();
    formData.append("resume", file);

    let res = await fetch("/api/upload.php", {
        method: "POST",
        body: formData,
        credentials: "include"
    });

    let data = await res.json();
    console.log("UPLOAD:", data);

    document.getElementById("msg").innerText = data.message;

    loadFiles();
});

// 🔥 LOAD FILES DEBUG
async function loadFiles() {
    let res = await fetch('/api/get_files.php', {
        credentials: "include"
    });

    let files = await res.json();
    console.log("FILES:", files);

    let html = "";

    if (!files || files.length === 0) {
        html = "<p>No files uploaded</p>";
    } else {
        files.forEach(file => {
            html += `
                <div class="file-box">
                    <div>
                        <input type="checkbox" class="fileCheck" value="${file.id}">
                        ${file.file_name}
                    </div>

                    <a href="/api/download.php?id=${file.id}">
                        <button style="background:green;color:white;border:none;padding:5px;">
                            Download
                        </button>
                    </a>
                </div>
            `;
        });
    }

    document.getElementById("fileList").innerHTML = html;
}

// DELETE
async function deleteSelected() {
    let selected = document.querySelectorAll('.fileCheck:checked');

    for (let s of selected) {
        await fetch('/api/delete.php', {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({file_id: s.value}),
            credentials: "include"
        });
    }

    loadFiles();
}

loadFiles();
</script>

</body>
</html>
