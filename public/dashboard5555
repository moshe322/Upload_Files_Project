<!DOCTYPE html>
<html>
<head>
<title>Dashboard</title>

<style>
body {
    font-family: Arial;
    margin: 0;
    padding: 20px;
    color: white;

    /* 🔥 Background with overlay */
    background:
        linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
        url('assets/images/dashboard-blue.png') no-repeat center center fixed;

    background-size: cover;
}

/* Header */
.header {
    text-align: center;
    font-size: 28px;
    font-weight: bold;
    margin-bottom: 20px;
}

/* Layout */
.container {
    display: flex;
    gap: 20px;
}

/* Upload section */
.upload-section {
    width: 300px;
    background: white;
    color: black;
    padding: 15px;
    border-radius: 10px;
}

/* File input */
input[type="file"] {
    background: blue;
    color: white;
    padding: 8px;
    border-radius: 5px;
    width: 100%;
}

/* Upload button */
.upload-btn {
    background: green;
    color: white;
    padding: 10px;
    border: none;
    width: 100%;
    margin-top: 10px;
    cursor: pointer;
}

/* Files section */
.files-section {
    flex: 1;
    background: white;
    color: black;
    padding: 15px;
    border-radius: 10px;
}

/* File boxes */
.file-box {
    background: pink;
    padding: 10px;
    margin: 8px 0;
    border-radius: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Delete button */
.delete-btn {
    background: red;
    color: white;
    padding: 10px;
    border: none;
    margin-bottom: 10px;
    cursor: pointer;
}

/* Download button */
.download-btn {
    background: green;
    color: white;
    border: none;
    padding: 5px 10px;
    cursor: pointer;
}
</style>

</head>

<body>

<div class="header">Welcome to Document Page</div>

<div class="container">

    <!-- LEFT: Upload -->
    <div class="upload-section">
        <h3>Upload File</h3>

        <form id="uploadForm">
            <input type="file" id="resume" required>
            <button class="upload-btn" type="submit">Upload</button>
        </form>

        <p id="msg"></p>
    </div>

    <!-- RIGHT: Files -->
    <div class="files-section">
        <h3>Your Files</h3>

        <button class="delete-btn" onclick="deleteSelected()">Delete Selected</button>

        <div id="fileList"></div>
    </div>

</div>

<script>

// Upload
document.getElementById("uploadForm").addEventListener("submit", async function(e) {
    e.preventDefault();

    let file = document.getElementById("resume").files[0];

    if (!file) {
        alert("Select file first");
        return;
    }

    document.getElementById("msg").innerText = "Uploading...";

    let formData = new FormData();
    formData.append("resume", file);

    let res = await fetch("/api/upload.php", {
        method: "POST",
        body: formData,
        credentials: "include"
    });

    let data = await res.json();

    document.getElementById("msg").innerText = data.message;

    loadFiles();
});

// Load files
async function loadFiles() {
    let res = await fetch('/api/get_files.php', {
        credentials: "include"
    });

    let files = await res.json();

    let html = "";

    if (!files || files.length === 0) {
        html = "<p>No files uploaded</p>";
    } else {
        files.forEach(file => {
            html += `
                <div class="file-box">
                    <div>
                        <input type="checkbox" class="fileCheck" value="${file.id}">
                        ${file.file_name}
                    </div>

                    <a href="/api/download.php?id=${file.id}">
                        <button class="download-btn">Download</button>
                    </a>
                </div>
            `;
        });
    }

    document.getElementById("fileList").innerHTML = html;
}

// Delete selected
async function deleteSelected() {
    let selected = document.querySelectorAll('.fileCheck:checked');

    if (selected.length === 0) {
        alert("Select files first");
        return;
    }

    for (let s of selected) {
        await fetch('/api/delete.php', {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({file_id: s.value}),
            credentials: "include"
        });
    }

    loadFiles();
}

// Load on start
loadFiles();

</script>

</body>
</html>
